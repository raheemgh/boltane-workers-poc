{
  "name": "ava-onboarding-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Ava \u2014 Boltane's WhatsApp bot onboarding chat backend (Cloudflare Worker: Hono + a SetupLock Durable Object + Cron Triggers).",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc --noEmit && tsc -p tsconfig.workers.json",
    "test": "vitest run",
    "deploy": "wrangler deploy",
    "check:lock": "node scripts/lock-check.mjs",
    "check:chat": "node scripts/chat-check.mjs",
    "check:upload": "node scripts/upload-check.mjs",
    "check:cron": "node scripts/cron-check.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "smoke:deployed": "node scripts/smoke-deployed.mjs",
    "smoke:openrouter": "node scripts/openrouter-smoke.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "hono": "^4",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5",
    "@types/node": "^20.14.10",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5",
    "wrangler": "^4"
  }
}
