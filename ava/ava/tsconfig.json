{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  // src/ is type-checked by tsconfig.workers.json (Workers globals);
  // anything under src/ that tests import is checked here too.
  "include": ["api/**/*.ts", "lib/**/*.ts", "tests/**/*.ts"]
}
