--- a/server.ts
+++ /dev/null
@@ -1,84 +0,0 @@
-// server.ts
-//
-// Render entrypoint. Vercel ran each file under api/ as its own isolated
-// serverless function; Render runs one persistent process, so this file
-// wires all six of them into routes on a single Express app instead.
-//
-// Deliberately NOT a rewrite: every handler under api/ still has the
-// exact same (req, res) signature and internal req.method/OPTIONS
-// handling it had for Vercel (see each file's own CORS/method checks) —
-// this file only does routing. That was a one-line type-import swap per
-// file (VercelRequest/VercelResponse -> express's Request/Response,
-// which are structurally close enough that no handler logic changed).
-//
-// Routes are mounted with app.all() rather than app.post()/app.get(),
-// specifically so each handler's own internal OPTIONS/method-not-allowed
-// logic keeps working unchanged — Express would otherwise never route an
-// OPTIONS preflight request to a route registered with app.post() alone.
-//
-// express.json() below only engages for Content-Type: application/json
-// (its default matcher) — POST /upload-pdf sends multipart/form-data, so
-// this middleware leaves that request's body stream untouched for
-// lib/multipart.ts's busboy parser to read directly off req.
-//
-// dotenv loads FIRST, before any handler import below — several lib
-// files read process.env at module load time, not per-request (e.g.
-// lib/cors.ts's ALLOWED_ORIGIN is a top-level const), so those imports
-// must run after the env is populated or they'd permanently capture
-// empty values. In production on Render this import is a harmless
-// no-op — env vars are set directly in the dashboard, no .env.local
-// file exists there to load.
-// require(), not import, deliberately: TypeScript/bundler ESM->CJS
-// transforms are allowed to hoist import statements above plain code —
-// a plain require() call has no such ambiguity, it always runs exactly
-// where it's written. That guarantee is the entire point of this line.
-require("dotenv").config({ path: ".env.local" });
-
-import express from "express";
-
-import { asyncHandler, errorMiddleware } from "./lib/asyncHandler";
-import chatHandler from "./api/chat";
-import completeSetupHandler from "./api/complete-setup";
-import lookupSignupHandler from "./api/lookup-signup";
-import uploadPdfHandler from "./api/upload-pdf";
-import activatePendingHandler from "./api/cron/activate-pending";
-import sweepPdfScansHandler from "./api/cron/sweep-pdf-scans";
-
-const app = express();
-// Express's json() defaults to a 100kb body limit — too small for a
-// long conversation_history payload on later chat turns. Vercel's own
-// serverless functions defaulted to ~4.5MB; matching that here so a
-// long-running Ava conversation doesn't start silently failing to
-// parse partway through.
-app.use(express.json({ limit: "4.5mb" }));
-
-// asyncHandler(): Express 4 doesn't catch rejected promises from async
-// handlers — without it, one unexpected throw crashes the whole process.
-app.all("/chat", asyncHandler(chatHandler));
-app.all("/complete-setup", asyncHandler(completeSetupHandler));
-app.all("/lookup-signup", asyncHandler(lookupSignupHandler));
-app.all("/upload-pdf", asyncHandler(uploadPdfHandler));
-app.all("/cron/activate-pending", asyncHandler(activatePendingHandler));
-app.all("/cron/sweep-pdf-scans", asyncHandler(sweepPdfScansHandler));
-
-// Render's health check + what an external keep-alive/monitor pings.
-// Deliberately does nothing but confirm the process is up — no Supabase
-// call here, so it stays cheap and can't itself contribute to hitting
-// any downstream rate limit.
-app.get("/health", (_req, res) => {
-  res.status(200).json({ ok: true });
-});
-
-// Must come after all routes: turns any forwarded error (including
-// express.json's own body-parse errors) into a JSON response.
-app.use(errorMiddleware);
-
-// Last-resort safety net: log instead of dying on a stray rejection.
-process.on("unhandledRejection", (reason) => {
-  console.error("Unhandled promise rejection:", reason);
-});
-
-const port = Number(process.env.PORT) || 3000;
-app.listen(port, () => {
-  console.log(`ava-backend listening on port ${port}`);
-});
